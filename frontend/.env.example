# NetTest Frontend Environment Variables

# API base URL for the backend server
# For production deployment, set this to your backend URL:
# VITE_API_URL=https://api.nettest.app
#
# For local development, leave empty to use Vite proxy (localhost:3000)
# VITE_API_URL=

# Local dev server port (default: 5173)
# VITE_PORT=5173
